# Copy to .dev.vars for the application. Never commit populated secret files.
DEMO_MODE=true
# Optional server-side OpenAI-compatible chat provider. Guided coaching works without it.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Optional Python service / simulator environment (export or use docker compose --env-file).
AI_SERVICE_TOKEN=
FORM_BASE_URL=http://127.0.0.1:4173
FORM_DEVICE_ID=
FORM_DEVICE_TOKEN=
FORM_DEVICE_TOKENS_JSON={}
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
